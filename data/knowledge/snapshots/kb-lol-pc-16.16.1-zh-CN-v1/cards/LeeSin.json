    {
      "ability_id": "ability:LeeSin:q:ddragon-16.16.1",
      "damage_types": [
        "physical"
      ],
      "detailed_description_zh": "李青发出刺耳的声波定位敌人，对命中的首个敌人造成【数值】物理伤害，提供目标的真实视野，并使李青可以在接下来的【数值】秒内再次施放。 再次施放：李青突进向被声波击中的敌人，造成【数值】到【数值】物理伤害（基于目标已损失的生命值）。",
      "extraction": {
        "method": "deterministic_client_markup_v1",
