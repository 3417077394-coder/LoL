    {
      "ability_id": "ability:Thresh:q:ddragon-16.16.1",
      "damage_types": [
        "magic"
      ],
      "detailed_description_zh": "锤石投出他的镰刀，晕眩命中的第一个单位并将其拉拽向锤石【数值】秒。镰刀造成【数值】魔法伤害并且还会在持续期间提供真实视野。 锤石可以再次施放这个技能来将自身拉拽到敌人处。 如果这个技能命中了，那么它的冷却时间缩短【数值】秒。",
      "extraction": {
        "method": "deterministic_client_markup_v1",
