      "name_en": "Cell Division",
      "name_zh": "细胞分裂",
      "slot": "passive",
      "source_ref_ids": [
        "source:ddragon:16.16.1:zh_CN:Zac",
        "source:ddragon:16.16.1:en_US:Zac",
        "source:communitydragon:16.16:zh_cn:Zac",
        "source:wiki:1307984:4007761"
