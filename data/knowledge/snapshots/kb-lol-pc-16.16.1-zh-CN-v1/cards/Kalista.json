    {
      "ability_id": "ability:Kalista:q:ddragon-16.16.1",
      "damage_types": [
        "physical"
      ],
      "detailed_description_zh": "卡莉丝塔掷出一支长矛，对命中的第一个目标造成【数值】物理伤害。如果这个技能击杀了目标，那么长矛会继续前行，将撕裂的层数带给命中的下一个目标。 卡莉丝塔可以在使用这个技能后使用武术姿态的冲刺。",
      "extraction": {
        "method": "deterministic_client_markup_v1",
        "notes": [
