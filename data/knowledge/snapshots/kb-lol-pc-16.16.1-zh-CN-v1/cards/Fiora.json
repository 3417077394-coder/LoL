    {
      "ability_id": "ability:Fiora:q:ddragon-16.16.1",
      "damage_types": [
        "physical"
      ],
      "detailed_description_zh": "菲奥娜向一个方向进行突刺并刺击相距最近的敌人、守卫或建筑物，造成【数值】物理伤害。这次打击会优先攻击破绽和将被此打击击杀的单位。 如果菲奥娜命中了一个敌人，那么这个技能的冷却时间就会缩短【数值】%。",
      "extraction": {
        "method": "deterministic_client_markup_v1",
