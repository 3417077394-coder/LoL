    {
      "ability_id": "ability:Quinn:q:ddragon-16.16.1",
      "damage_types": [
        "physical"
      ],
      "detailed_description_zh": "奎因命令华洛进行俯冲，用侵扰标记命中的第一个敌人、降低其视野半径【数值】秒并对所有周围的敌人们造成【数值】物理伤害。 如果命中的第一个敌人不是英雄，那么该敌人会还会被缴械【数值】秒。",
      "extraction": {
        "method": "deterministic_client_markup_v1",
