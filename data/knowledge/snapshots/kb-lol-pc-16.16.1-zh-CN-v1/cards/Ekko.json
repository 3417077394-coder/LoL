      "name_en": "Timewinder",
      "name_zh": "时间卷曲器",
      "slot": "q",
      "source_ref_ids": [
        "source:ddragon:16.16.1:zh_CN:Ekko",
        "source:ddragon:16.16.1:en_US:Ekko",
