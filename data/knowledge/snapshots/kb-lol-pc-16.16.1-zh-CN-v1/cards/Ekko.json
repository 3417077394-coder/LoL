    {
      "ability_id": "ability:Ekko:q:ddragon-16.16.1",
      "damage_types": [
        "magic"
      ],
      "detailed_description_zh": "艾克投出一个设备，造成【数值】魔法伤害。在命中一名英雄或到达它的距离终点后，它会扩展为一个领域来使其中的敌人减速【数值】%。在它扩展后，艾克会将其召回，造成【数值】魔法伤害。",
      "extraction": {
        "method": "deterministic_client_markup_v1",
        "notes": [
