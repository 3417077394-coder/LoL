    {
      "ability_id": "ability:Zoe:q:ddragon-16.16.1",
      "damage_types": [
        "magic"
      ],
      "detailed_description_zh": "佐伊发射一颗飞星，基于它的飞行距离来对命中的第一个敌人造成不断提升的伤害 -- 【数值】到【数值】魔法伤害。 佐伊可以再次施放这个技能来将这个飞弹重新导向到佐伊附近的一个新位置。",
      "extraction": {
        "method": "deterministic_client_markup_v1",
        "notes": [
