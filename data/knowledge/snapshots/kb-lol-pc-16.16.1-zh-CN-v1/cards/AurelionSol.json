      "mechanism_critical_numbers_preserved": false,
      "name_en": "Singularity",
      "name_zh": "星芒凝汇",
      "slot": "e",
      "source_ref_ids": [
        "source:ddragon:16.16.1:zh_CN:AurelionSol",
        "source:ddragon:16.16.1:en_US:AurelionSol",
        "source:communitydragon:16.16:zh_cn:AurelionSol",
        "source:wiki:1573086:4038217"
      ],
      "status_terms_zh": [
        "拉拽"
      ],
      "summary_en": "Aurelion Sol summons a black hole, damaging enemies and slowly pulling them toward its center. This ability grants Stardust each time an enemy dies within the black hole and for each second an enemy champion is caught inside it. The center of the black hole executes enemies who are below a certain percentage of their maximum health. Stardust increases Singularity's area as well as the execution threshold.",
      "summary_zh": "奥瑞利安·索尔召唤一个黑洞，对敌人们造成伤害并缓慢地将他们拉拽向黑洞的中心。每有一名敌人在黑洞中阵亡，以及一名敌方英雄在黑洞中每被困住一秒，这个技能都会提供【星尘】。黑洞的中心会处决低于一定百分比最大生命值的敌人。【星尘】会提升【星芒凝汇】的区域以及处决阈值。",
      "wiki_source_ref_ids": [
        "source:wiki:1573086:4038217"
      ]
    },
    {
      "ability_id": "ability:AurelionSol:r:ddragon-16.16.1",
      "damage_types": [
        "magic"
      ],
      "detailed_description_zh": "奥瑞利安·索尔从诸天摘取一颗巨型星星并将其砸入大地中，对敌人造成【数值】魔法伤害、【数值】秒晕眩并且每命中一名英雄就会吸收【数值】星尘。 收集【数值】星尘时会使下一个星落转变为天瀑。 天瀑：奥瑞利安·索尔从宇宙中拖来一个星座的怒火，在一个更大的区域造成【数值】魔法伤害，对命中的敌人们造成【数值】秒击飞，并释放一道巨型冲击波，对英雄和史诗级野怪造成【数值】魔法伤害并对命中的所有敌人造成持续1秒的【数值】%减速。",
      "extraction": {
        "method": "deterministic_client_markup_v1",
