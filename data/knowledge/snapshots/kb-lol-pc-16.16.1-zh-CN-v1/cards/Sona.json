    {
      "ability_id": "ability:Sona:q:ddragon-16.16.1",
      "damage_types": [
        "magic"
      ],
      "detailed_description_zh": "娑娜对相距最近的2名敌人造成【数值】魔法伤害，优先以英雄为目标。她随后会开始一段新的旋律。这个技能每对一名敌方英雄造成伤害就会获得1层渐入佳音。 旋律：娑娜获得一个持续【数值】秒的光环，来使其中的友方英雄在【数值】秒内的下一次攻击附带【数值】魔法伤害 %i:OnHit%。 能量和弦—断奏：【能量和弦】造成额外伤害 (【数值】总魔法伤害)。",
      "extraction": {
        "method": "deterministic_client_markup_v1",
