    {
      "ability_id": "ability:Jhin:w:ddragon-16.16.1",
      "damage_types": [
        "physical"
      ],
      "detailed_description_zh": "烬进行一次远程射击，对命中的第一个英雄和沿途的其它敌人造成【数值】物理伤害。 如果被【W致命华彩】命中的敌方英雄在前【数值】秒受到过来自烬的友方英雄的伤害，那么这个英雄还会被禁锢【数值】秒，并为烬提供低语的移动速度加成。",
      "extraction": {
