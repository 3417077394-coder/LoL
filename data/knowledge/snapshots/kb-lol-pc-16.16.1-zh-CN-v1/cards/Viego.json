      "name_en": "Sovereign's Domination",
      "name_zh": "君命已决",
      "slot": "passive",
      "source_ref_ids": [
        "source:ddragon:16.16.1:zh_CN:Viego",
        "source:ddragon:16.16.1:en_US:Viego",
        "source:communitydragon:16.16:zh_cn:Viego",
