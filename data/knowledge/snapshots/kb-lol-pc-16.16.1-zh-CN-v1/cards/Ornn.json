    {
      "ability_id": "ability:Ornn:w:ddragon-16.16.1",
      "damage_types": [
        "magic"
      ],
      "detailed_description_zh": "奥恩向前不可阻挡地重踏，同时喷吐炎息，在【数值】秒里持续造成共【数值】%最大生命值的魔法伤害。被最后一道炎息命中的敌人，会变成易碎效果，持续【数值】秒。 对易碎状态的敌人施加的下一个定身效果将使该效果的持续时间提升30%并对目标造成额外的【数值】最大生命值的魔法伤害。奥恩的普攻会击退易碎状态下的目标，并造成额外伤害。",
      "extraction": {
        "method": "deterministic_client_markup_v1",
