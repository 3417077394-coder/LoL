  "abilities": [
    {
      "ability_id": "ability:Brand:passive:ddragon-16.16.1",
      "damage_types": [
        "unknown"
      ],
      "detailed_description_zh": "布兰德的技能会对他的目标施加【烈焰焚身】效果，在4秒里持续造成伤害，最多可叠加3次。如果布兰德击杀了身上带有【烈焰焚身】的敌人，那么他会回复法力值。当【炽热之焰】在一名英雄或大型野怪身上叠至满层时，它会变得不稳定。它会在2秒内爆炸，在目标附近的区域施加法术特效并造成大量伤害。",
      "extraction": {
        "method": "deterministic_client_markup_v1",
        "notes": [
