    {
      "ability_id": "ability:Yone:q:ddragon-16.16.1",
      "damage_types": [
        "physical"
      ],
      "detailed_description_zh": "永恩向前出剑，造成【数值】物理伤害。 在命中时，提供一层持续【数值】秒的可叠加效果。在积攒2层效果后，这个技能会使永恩向前冲刺，并带着一阵能够击飞敌人【数值】秒的的旋风，造成【数值】物理伤害。",
      "extraction": {
        "method": "deterministic_client_markup_v1",
