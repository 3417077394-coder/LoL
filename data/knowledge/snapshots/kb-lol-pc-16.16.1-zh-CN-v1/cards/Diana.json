    {
      "ability_id": "ability:Diana:w:ddragon-16.16.1",
      "damage_types": [
        "magic"
      ],
      "detailed_description_zh": "黛安娜生成3颗持续【数值】秒的护体法球，可在接触时爆炸，每颗造成【数值】魔法伤害，至多达到【数值】伤害。 黛安娜也会获得相同持续时间的【数值】护盾值。当最后一颗法球爆炸后，她会获得额外的【数值】护盾值并刷新持续时间。",
      "extraction": {
