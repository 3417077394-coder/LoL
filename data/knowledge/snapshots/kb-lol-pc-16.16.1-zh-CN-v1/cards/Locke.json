    {
      "ability_id": "ability:Locke:q:ddragon-16.16.1",
      "damage_types": [
        "magic"
      ],
      "detailed_description_zh": "洛克依次击出三颗驱魔大钉，对命中的敌人造成【数值】魔法伤害，并附上一层印记。大钉会造成持续【数值】/【数值】/【数值】秒的【数值】/【数值】/【数值】%的减速效果，随命中数量叠加。 洛克的攻击会引爆敌人身上的驱魔大钉印记，每层造成【数值】魔法伤害，并在2层和3层印记时分别造成【数值】/【数值】%的额外伤害。",
      "extraction": {
        "method": "deterministic_client_markup_v1",
