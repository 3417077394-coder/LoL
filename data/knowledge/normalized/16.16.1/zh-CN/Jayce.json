        "effective_ddragon_version": "16.16.1",
        "effective_public_patch_alias": "26.16",
        "fact_id": "fact:Jayce:q:dual_form_combined:ddragon-16.16.1",
        "form_id": "dual_form_combined",
        "mechanics_summary": "锤形态跳向目标并减速；炮形态发射可在命中或最远距离爆炸的远程电球。",
        "official_description": "锤形态：跳向一个敌人，对敌人造成物理伤害和减速效果。 炮形态：发射一团电球，在命中一名敌人或者到达最大射程后爆炸，对命中的敌人造成物理伤害。",
        "official_name": "苍穹之跃 / 电能震荡",
        "raw_payload_path": "data/knowledge/raw/16.16.1/zh_CN/champion/Jayce.json",
        "slot": "q",
        "source_ref_ids": [
          "source:ddragon:16.16.1:zh_CN:Jayce",
          "source:ddragon:16.16.1:en_US:Jayce"
        ]
      },
      {
        "effective_ddragon_version": "16.16.1",
        "effective_public_patch_alias": "26.16",
        "fact_id": "fact:Jayce:w:dual_form_combined:ddragon-16.16.1",
        "form_id": "dual_form_combined",
        "mechanics_summary": "锤形态创造近身伤害区域并通过攻击回复法力；炮形态强化若干次普攻的攻速。",
        "official_description": "锤形态：被动：每次攻击回复法力。主动：创造一个闪电领域，在数秒内对附近的敌人造成伤害。 炮形态：杰斯的活力暴涨，将攻击速度提升至最大值，此效果在若干次攻击后消失。",
        "official_name": "闪电领域 / 超能电荷",
        "raw_payload_path": "data/knowledge/raw/16.16.1/zh_CN/champion/Jayce.json",
        "slot": "w",
        "source_ref_ids": [
          "source:ddragon:16.16.1:zh_CN:Jayce",
          "source:ddragon:16.16.1:en_US:Jayce"
        ]
      },
      {
        "effective_ddragon_version": "16.16.1",
        "effective_public_patch_alias": "26.16",
        "fact_id": "fact:Jayce:e:dual_form_combined:ddragon-16.16.1",
        "form_id": "dual_form_combined",
        "mechanics_summary": "锤形态击退目标；炮形态生成友军加速门，并强化穿过门的 Q 弹道。",
        "official_description": "锤形态：对一个敌人造成魔法伤害，并将目标击退一小段距离。 炮形态：展开一个加速之门，所有穿过它的友军英雄都会得到移动速度加成。如果电能震荡穿过这个门发射，那么它的弹道速度和射程都会得到提高，并且伤害会提升。",
        "official_name": "雷霆一击 / 加速之门",
        "raw_payload_path": "data/knowledge/raw/16.16.1/zh_CN/champion/Jayce.json",
        "slot": "e",
        "source_ref_ids": [
          "source:ddragon:16.16.1:zh_CN:Jayce",
          "source:ddragon:16.16.1:en_US:Jayce"
        ]
