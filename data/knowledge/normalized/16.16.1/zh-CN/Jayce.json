        "effective_ddragon_version": "16.16.1",
        "effective_public_patch_alias": "26.16",
        "fact_id": "fact:Jayce:r:dual_form_combined:ddragon-16.16.1",
        "form_id": "dual_form_combined",
        "mechanics_summary": "在锤与炮形态之间切换，改变攻击距离、基础技能和切换后的首次攻击效果。",
        "official_description": "锤形态：将墨丘利之锤变成墨丘利之炮，获得新的技能和远程攻击能力。切换至这个形态后的第一下攻击将会减少目标的护甲和魔法抗性。 炮形态：将墨丘利之炮变成墨丘利之锤，获得新的技能和护甲与魔法抗性加成，切换至这个形态后的第一下攻击将会造成额外的魔法伤害。",
        "official_name": "墨丘利之炮 / 墨丘利之锤",
        "raw_payload_path": "data/knowledge/raw/16.16.1/zh_CN/champion/Jayce.json",
